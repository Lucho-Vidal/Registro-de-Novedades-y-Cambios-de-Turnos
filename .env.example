# ==============================================================================
# Configuración de Supabase para RENO y Publicación de Actualizaciones OTA
# ==============================================================================
# Copia este archivo como ".env" en la raíz del proyecto y completa con tus
# claves reales (el archivo .env está en .gitignore y NO se sube a Git).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_tu_clave_secreta_aqui

# Opcional: Clave pública Publishable Key de la aplicación (sb_publishable_...)
# SUPABASE_ANON_KEY=sb_publishable_...

# Opcional: Bucket y URL base pública del almacenamiento de actualizaciones
# SUPABASE_STORAGE_BUCKET=updates
# RENO_UPDATES_URL=https://tu-proyecto.supabase.co/storage/v1/object/public/updates
