# ==============================================================================
# RENO v2.0.0 — Variables de Entorno y Configuración de Supabase
# ==============================================================================
# Copie este archivo a '.env' y complete con las credenciales de su proyecto Supabase.
# El archivo '.env' está ignorado en .gitignore para proteger sus claves secretas.

# URL base del proyecto en Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon key) utilizada por los clientes para sincronizar datos
SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui

# Clave de servicio secreta (service_role key)
# OBLIGATORIA para la subida desatendida de actualizaciones con:
# python scripts/publicar_actualizacion.py --subir
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key_aqui

# Nombre del bucket de almacenamiento para instaladores y manifiestos OTA (por defecto: updates)
SUPABASE_STORAGE_BUCKET=updates
